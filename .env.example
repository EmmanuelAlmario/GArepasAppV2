# =============================================================
# GArepasAppV2 — variables de entorno
# Copia este archivo a .env y completa los valores reales.
# El archivo .env NO se sube al repositorio (ver .gitignore).
# =============================================================
#
# PERFILES
# - Local: `./mvnw spring-boot:run` activa el perfil `dev`
#   automaticamente (H2 en memoria + datos de prueba). No hace
#   falta este archivo para desarrollar.
# - Produccion: perfil `prod` (application-prod.properties, PostgreSQL).
#   Es el perfil por defecto: ejecutar el jar sin activar otro perfil.
#   Son OBLIGATORIAS:
#   DB_URL, DB_USERNAME, DB_PASSWORD y ADMIN_PASSWORD. Sin ellas la app no arranca
#   (falla rapido, a proposito).
# =============================================================

# ---------- PostgreSQL (produccion) ----------
DB_URL=jdbc:postgresql://localhost:5432/gordoarepas
DB_USERNAME=postgres
DB_PASSWORD=tu_password

# ---------- Admin inicial (produccion: obligatoria y fuerte) ----------
# En dev, si no se define, el perfil usa admin123.
# OJO: UsuarioSeeder re-sincroniza la contrasena del admin con esta
# variable en cada arranque. Si el admin la cambia desde la app,
# quita esta variable del entorno o el cambio se perderá.
ADMIN_PASSWORD=cambia_esta_clave

# ---------- HTTPS ----------
# Con HTTPS activo (produccion real), la cookie de sesion debe ser segura.
SERVER_SERVLET_SESSION_COOKIE_SECURE=true

# ---------- Solo perfil dev ----------
# Contrasena del cajero de prueba (si no quieres cajero123).
# CAJERO_PASSWORD=cajero123

# ---------- Puerto (por defecto 8080) ----------
# PORT=8080
