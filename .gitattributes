# Normaliza los finales de linea: el proyecto se desarrolla en Windows y
# los ficheros versionados usan CRLF, con LF en los binarios.
* text=auto eol=crlf

*.java text eol=crlf
*.html text eol=crlf
*.css text eol=crlf
*.js text eol=crlf
*.sql text eol=crlf
*.md text eol=crlf
*.properties text eol=crlf
*.yml text eol=crlf
*.json text eol=crlf
*.xml text eol=crlf
*.puml text eol=crlf
*.txt text eol=crlf

# Los scripts de shell necesitan LF: con CRLF el shebang queda roto
# y Linux responde "./mvnw: not found".
mvnw text eol=lf
*.sh text eol=lf
mvnw.cmd text eol=crlf

*.png binary
*.woff binary
*.woff2 binary
*.jar binary
